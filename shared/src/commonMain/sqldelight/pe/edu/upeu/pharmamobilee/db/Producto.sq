CREATE TABLE producto (
    id INTEGER NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    pendiente INTEGER NOT NULL DEFAULT 0,
    activo INTEGER NOT NULL DEFAULT 1,
    categoria_id INTEGER,
    categoria_nombre TEXT NOT NULL DEFAULT 'Sin categoría',
    stock_disponible INTEGER NOT NULL DEFAULT 1
);

-- Una única fila conserva el instante de la última sincronización completa.
-- Se mantiene junto al catálogo local para que Android e iOS compartan el dato.
CREATE TABLE estado_sincronizacion (
    clave INTEGER NOT NULL PRIMARY KEY CHECK (clave = 1),
    ultima_correcta_millis INTEGER
);

listarTodos:
SELECT id, nombre, precio, stock, pendiente, activo,
       categoria_id AS categoriaId,
       categoria_nombre AS categoriaNombre,
       stock_disponible AS stockDisponible
FROM producto ORDER BY nombre ASC;

listarPendientes:
SELECT id, nombre, precio, stock, pendiente, activo,
       categoria_id AS categoriaId,
       categoria_nombre AS categoriaNombre,
       stock_disponible AS stockDisponible
FROM producto WHERE pendiente = 1;

insertar:
INSERT OR REPLACE INTO producto(
    id, nombre, precio, stock, pendiente, activo, categoria_id, categoria_nombre, stock_disponible
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

borrarSincronizados:
DELETE FROM producto WHERE pendiente = 0;

siguienteIdLocal:
SELECT COALESCE(MIN(id), 0) FROM producto;

borrarPorId:
DELETE FROM producto WHERE id = ?;

guardarUltimaSincronizacion:
INSERT OR REPLACE INTO estado_sincronizacion(clave, ultima_correcta_millis)
VALUES (1, ?);

obtenerUltimaSincronizacion:
SELECT ultima_correcta_millis
FROM estado_sincronizacion
WHERE clave = 1;
